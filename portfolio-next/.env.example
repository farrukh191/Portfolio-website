# Copy this file to .env.local (same folder as package.json), fill in ONE key, then restart `npm run dev`.
# On Vercel add the same names under Project Settings > Environment Variables.
# Keep comments on their own lines. Never commit real keys.

# Which provider to use: groq, gemini, openai or anthropic. Optional: if left out,
# the first provider that has a key is used.
LLM_PROVIDER=groq

# Groq (free tier available): https://console.groq.com/keys
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-3.8-flash

# Optional extras
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
